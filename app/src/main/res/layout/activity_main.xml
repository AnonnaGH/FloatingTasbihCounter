<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@drawable/v6_page_bg">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="☾" android:textColor="#07513A" android:textSize="36sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Floating Tasbih" android:textColor="#064934" android:textStyle="bold" android:textSize="34sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="—  C O U N T E R  —" android:textColor="#B48224" android:textStyle="bold" android:textSize="16sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Dhikr made simple, anytime, anywhere" android:textColor="#625C54" android:textSize="14sp" android:paddingBottom="16dp"/>

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/v6_card" android:padding="14dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="▣  Zikr নির্বাচন করুন" android:textStyle="bold" android:textColor="#074C38" android:textSize="16sp" android:paddingBottom="8dp"/>
<Spinner android:id="@+id/zikrSpinner" android:layout_width="match_parent" android:layout_height="58dp" android:background="@drawable/v6_pill"/>
</LinearLayout>

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/v6_card" android:layout_marginTop="14dp" android:padding="14dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="230dp" android:gravity="center" android:orientation="horizontal">
<LinearLayout android:layout_width="70dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center"><Button android:id="@+id/minusButton" android:layout_width="64dp" android:layout_height="64dp" android:text="−" android:textSize="30sp" android:textColor="#07513A" android:background="@drawable/v6_square"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MINUS" android:textColor="#07513A" android:textStyle="bold" android:paddingTop="6dp"/></LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="210dp" android:gravity="center" android:orientation="vertical" android:background="@drawable/v6_counter_panel" android:layout_marginHorizontal="10dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="◌" android:textColor="#C79834" android:textSize="34sp"/><TextView android:id="@+id/mainCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="0" android:textColor="#064934" android:textStyle="bold" android:textSize="66sp"/><TextView android:id="@+id/targetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Target: 33" android:textColor="#07513A" android:textStyle="bold" android:textSize="18sp"/></LinearLayout>
<LinearLayout android:layout_width="70dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center"><Button android:id="@+id/plusButton" android:layout_width="64dp" android:layout_height="64dp" android:text="+" android:textSize="30sp" android:textColor="#07513A" android:background="@drawable/v6_square"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PLUS" android:textColor="#07513A" android:textStyle="bold" android:paddingTop="6dp"/></LinearLayout>
</LinearLayout>
<RadioGroup android:id="@+id/targetGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
<RadioButton android:id="@+id/target33" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="33" android:gravity="center" android:button="@null" android:background="@drawable/v6_pill" android:textColor="#07513A" android:textStyle="bold" android:layout_margin="3dp"/>
<RadioButton android:id="@+id/target100" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="100" android:gravity="center" android:button="@null" android:background="@drawable/v6_pill" android:textColor="#07513A" android:textStyle="bold" android:layout_margin="3dp"/>
<RadioButton android:id="@+id/targetCustom" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="✎  Custom" android:gravity="center" android:button="@null" android:background="@drawable/v6_pill" android:textColor="#07513A" android:textStyle="bold" android:layout_margin="3dp"/>
</RadioGroup>
<EditText android:id="@+id/customTarget" android:layout_width="match_parent" android:layout_height="52dp" android:visibility="gone" android:inputType="number" android:hint="Custom target লিখুন" android:gravity="center" android:background="@drawable/v6_pill" android:textColor="#07513A" android:layout_marginTop="8dp"/>
<Button android:id="@+id/countButton" android:layout_width="match_parent" android:layout_height="68dp" android:text="◌  + COUNT\nট্যাপ করুন" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="20sp" android:background="@drawable/v6_green_button" android:layout_marginTop="10dp"/>
</LinearLayout>

<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⚙  GENERAL SETTINGS" android:textColor="#07513A" android:textStyle="bold" android:textSize="17sp" android:paddingTop="18dp" android:paddingBottom="7dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/v6_card">
<Switch android:id="@+id/vibrationSwitch" android:layout_width="match_parent" android:layout_height="60dp" android:text="▣   Vibration\n      Vibrate on each count" android:textColor="#17372E" android:paddingHorizontal="8dp"/>
<Switch android:id="@+id/soundSwitch" android:layout_width="match_parent" android:layout_height="60dp" android:text="🔊   Sound\n      Play sound on each count" android:textColor="#17372E" android:paddingHorizontal="8dp"/>
<Switch android:id="@+id/targetSoundSwitch" android:layout_width="match_parent" android:layout_height="60dp" android:text="♫   Target complete sound\n      Play sound when target is complete" android:textColor="#17372E" android:paddingHorizontal="8dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="◌   Bubble opacity" android:textColor="#17372E" android:textSize="16sp"/><TextView android:id="@+id/opacityValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="80%" android:textColor="#07513A" android:textStyle="bold"/></LinearLayout>
<SeekBar android:id="@+id/opacitySeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="80" android:progressTint="#07513A" android:thumbTint="#07513A"/>
</LinearLayout>

<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🔔  DUROOD ALERT (ON UNLOCK)" android:textColor="#07513A" android:textStyle="bold" android:textSize="17sp" android:paddingTop="18dp" android:paddingBottom="7dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/v6_card">
<Switch android:id="@+id/duroodSwitch" android:layout_width="match_parent" android:layout_height="64dp" android:text="Durood Alert\nPlay selected Durood when phone is unlocked" android:textColor="#17372E"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Select Durood / Salawat" android:textStyle="bold" android:textColor="#17372E" android:paddingTop="8dp"/>
<Spinner android:id="@+id/duroodSpinner" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/v6_pill"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="8dp"><TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="🔊   Alert Volume" android:textColor="#17372E" android:textStyle="bold"/><TextView android:id="@+id/duroodVolumeValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="80%" android:textColor="#07513A" android:textStyle="bold"/></LinearLayout>
<SeekBar android:id="@+id/duroodVolumeSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="80" android:progressTint="#07513A" android:thumbTint="#07513A"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ⓘ  নোট: Unlock Durood Arabic Text-to-Speech ব্যবহার করে।" android:textColor="#6E6A60" android:textSize="12sp"/>
</LinearLayout>

<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="▦  OTHER" android:textColor="#07513A" android:textStyle="bold" android:textSize="17sp" android:paddingTop="18dp" android:paddingBottom="7dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<Button android:id="@+id/resetButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="80dp" android:text="↻\nCount Reset" android:textAllCaps="false" android:textColor="#07513A" android:background="@drawable/v6_pill" android:layout_margin="3dp"/>
<Button android:id="@+id/startButton" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="80dp" android:text="◈\nFloating Counter\nচালু করুন" android:textAllCaps="false" android:textColor="#FFFFFF" android:background="@drawable/v6_green_button" android:layout_margin="3dp"/>
<Button android:id="@+id/stopButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="80dp" android:text="ⓘ\nFloating বন্ধ" android:textAllCaps="false" android:textColor="#07513A" android:background="@drawable/v6_pill" android:layout_margin="3dp"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="☾  سُبْحَانَ الله  •  الْحَمْدُ لِلَّه  •  اللهُ أَكْبَر  ☾" android:textColor="#B48224" android:textSize="17sp" android:paddingVertical="22dp"/>
</LinearLayout></ScrollView>
